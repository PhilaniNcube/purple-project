# ---------------------------------------------------------------------------
# Payload
# ---------------------------------------------------------------------------
# Signs admin sessions and encrypts sensitive fields. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYLOAD_SECRET=

# ---------------------------------------------------------------------------
# Turso (libSQL) database — used by @payloadcms/db-sqlite
# ---------------------------------------------------------------------------
# turso db show <database> --url  /  turso db tokens create <database>
TURSO_DATABASE_URL=
TURSO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare R2 media storage (optional)
# ---------------------------------------------------------------------------
# Leave these blank to store uploads on local disk. Fill all five in and the
# S3 storage adapter switches on automatically — no code change required.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint: https://<accountId>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public bucket URL: https://<domain> or https://<bucket>.<accountId>.r2.dev
R2_PUBLIC_URL=
